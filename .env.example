# Copy to .env in the repository root. Use unquoted absolute paths without spaces.
# Both GNU Make and Bash read this file. Never commit .env.
# MARS_ROOT=/path/to/mars
# DOOM1_WAD=/path/to/doom1.wad
# PROCESSED_WAD=/path/to/doom1_processed.wad
# GBAWADUTIL=/path/to/GbaWadUtil
# MUSIC=1
# MUSIC_MIDI=/path/to/DoomHangar.mid
# PALETTE_SAMPLE=/path/to/gameplay.ppm
# GPGX_CORE=/path/to/genesis_plus_gx_libretro.so
# CHROMIUM=/path/to/chromium
# DISPLAY=:0
# XAUTHORITY=/path/to/Xauthority
# XDG_RUNTIME_DIR=/path/to/runtime
# DBUS_SESSION_BUS_ADDRESS=unix:path=/path/to/runtime/bus
# PULSE_SERVER=unix:/path/to/runtime/pulse/native
# SDL_AUDIODRIVER=pulse
